{
    "name": "captchafox/captchafox-typo3",
    "description": "CaptchaFox - Protects TYPO3 forms (EXT:form) against bots with CaptchaFox, verified on the server.",
    "type": "typo3-cms-extension",
    "version": "12.0.1",
    "license": [
        "GPL-2.0-or-later"
    ],
    "homepage": "https://captchafox.com",
    "support": {
        "docs": "https://docs.captchafox.com/en/integrations/typo3",
        "issues": "https://github.com/CaptchaFox/captchafox-typo3/issues",
        "source": "https://github.com/CaptchaFox/captchafox-typo3"
    },
    "require": {
        "php": "^8.1",
        "typo3/cms-core": "^12.4 || ^13.4",
        "typo3/cms-form": "^12.4 || ^13.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "CaptchaFox\\CaptchaFoxTypo3\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CaptchaFox\\CaptchaFoxTypo3\\Tests\\": "Tests/"
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "captchafox_official",
            "web-dir": ".Build/public"
        }
    }
}
